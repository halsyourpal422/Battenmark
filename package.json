{
  "name": "cad-service",
  "version": "0.5.6",
  "description": "Model-neutral CAD service for AI agents and software. FreeCAD/OpenCascade is the first authoritative backend. Working identifier \u2014 not a public brand.",
  "license": "Apache-2.0",
  "bin": {
    "agentcad": "bin/agentcad.mjs",
    "agentcad-mcp": "bin/agentcad-mcp.mjs"
  },
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:parametric && npm run test:selectors && npm run test:backend-registry",
    "test:cad": "npx tsx --tsconfig tsconfig.json src/cad/run-tests.ts",
    "test:freecad": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-freecad-tests.ts",
    "test:parity": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-parity-tests.ts",
    "demo:phase2": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-demo.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "agentcad": "npx tsx --tsconfig tsconfig.json src/cad/cli/main.ts",
    "agentcad:server": "npx tsx --tsconfig tsconfig.json src/cad/cli/main.ts serve",
    "agentcad:mcp": "npx tsx --tsconfig tsconfig.json src/cad/mcp/stdio.ts",
    "test:service": "npx tsx --tsconfig tsconfig.json src/cad/service/run-service-tests.ts",
    "test:cli": "npx tsx --tsconfig tsconfig.json src/cad/service/run-cli-tests.ts",
    "test:http": "npx tsx --tsconfig tsconfig.json src/cad/service/run-http-tests.ts",
    "test:mcp:stdio": "npx tsx --tsconfig tsconfig.json src/cad/service/run-mcp-tests.ts",
    "test:mcp:http": "npx tsx --tsconfig tsconfig.json src/cad/service/run-mcp-tests.ts",
    "test:transport-parity": "npx tsx --tsconfig tsconfig.json src/cad/service/run-transport-parity-tests.ts",
    "test:persistence": "npx tsx --tsconfig tsconfig.json src/cad/service/run-persistence-tests.ts",
    "test:phase3": "npm run test:service && npm run test:persistence && npm run test:http && npm run test:cli && npm run test:mcp:stdio && npm run test:transport-parity",
    "demo:phase3": "npx tsx --tsconfig tsconfig.json src/cad/service/run-demo-phase3.ts",
    "test:preview": "npx tsx --tsconfig tsconfig.json src/cad/preview/run-preview-tests.ts",
    "test:phase4": "npx tsx --tsconfig tsconfig.json src/cad/service/run-phase4-tests.ts",
    "demo:phase4": "npx tsx --tsconfig tsconfig.json src/cad/service/run-demo-phase4.ts",
    "test:llm-harness": "npx tsx --tsconfig tsconfig.json src/cad/service/run-llm-harness.ts",
    "test:parametric": "npx tsx --tsconfig tsconfig.json src/cad/run-parametric-tests.ts",
    "test:selectors": "npx tsx --tsconfig tsconfig.json src/cad/run-selector-tests.ts",
    "test:holes": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-hole-tests.ts",
    "test:patterns": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-pattern-tests.ts",
    "test:semantic-enclosure": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-semantic-enclosure-tests.ts",
    "test:phase5": "npm run test:parametric && npm run test:selectors && npm run test:holes && npm run test:patterns && npm run test:semantic-enclosure",
    "demo:phase5": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-demo-phase5.ts",
    "test:schema": "npx tsx --tsconfig tsconfig.json src/cad/run-schema-tests.ts",
    "test:discover": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-discover-tests.ts",
    "test:conformance": "npx tsx --tsconfig tsconfig.json src/cad/backend/run-conformance-tests.ts",
    "test:phase55": "npm run test:schema && npm run test:discover && npm run test:conformance",
    "demo:phase55": "npx tsx --tsconfig tsconfig.json src/cad/backend/run-demo-phase55.ts",
    "test:backend-registry": "npx tsx --tsconfig tsconfig.json src/cad/backend/run-registry-tests.ts",
    "test:backend-roles": "npx tsx --tsconfig tsconfig.json src/cad/backend/run-registry-tests.ts",
    "test:backend-pluggability": "npx tsx --tsconfig tsconfig.json src/cad/backend/run-registry-tests.ts",
    "test:macos": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-macos-proof.ts",
    "test:phase551": "npm run test:backend-registry && npm run test:schema && npm run test:discover && npm run test:macos",
    "demo:phase551": "npx tsx --tsconfig tsconfig.json src/cad/backend/run-registry-tests.ts",
    "test:assembly": "npx tsx --tsconfig tsconfig.json src/cad/run-assembly-tests.ts",
    "test:assembly-freecad": "npx tsx --tsconfig tsconfig.json src/cad/kernel/run-assembly-freecad-tests.ts",
    "test:phase6": "npm run test:assembly && npm run test:assembly-freecad"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hookform/resolvers": "^5.7.0",
    "@jscad/modeling": "^2.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  }
}
