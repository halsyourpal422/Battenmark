```mermaid
flowchart TD
    %% External Interfaces
    subgraph External["External Interfaces"]
        direction LR
        LLMs["LLM Agents\n(Claude, GPT, etc)"] -->|MCP/HTTP| Transports
        IDEs["IDE Extensions"] -->|MCP/HTTP| Transports
        Scripts["Custom Scripts"] -->|MCP/HTTP| Transports
    end

    %% Transports
    subgraph Transports["Transports"]
        direction LR
        HTTP["HTTP Transport"]
        MCP["MCP Transport"]
        CLI["CLI Transport"]
        Python["Python Client\n(thin HTTP)"]
    end

    %% Battenmark Core
    subgraph Core["Battenmark Core (Backend-Neutral)"]
        direction TB
        TypedOps["Typed Operations / CAD IR\n(schema v2)"]
        Registry["Backend Registry\n(open IDs, dynamic roles)"]
        Expressions["Expressions"]
        Selectors["Selectors / gref"]
        Persistence["Persistence / Revisions"]
        AssemSolver["Assembly / DOF\n(constraints, diagnostics)"]
    end

    %% Backends
    subgraph Backends["Authoritative & Preview Backends"]
        direction TB
        FreeCAD["FreeCAD / OpenCascade\nAuthoritative B-rep"]
        JSCAD["JSCAD CSG\nPreview / envelope support only"]
    end

    %% Flow
    External --> Transports
    Transports --> Core
    Core --> Registry
    Registry --> FreeCAD
    Registry --> JSCAD

    %% Styling
    classDef core fill:#f9fafb,stroke:#374151,stroke-width:1px;
    classDef transport fill:#dbeafe,stroke:#2563eb,stroke-width:1px;
    classDef backend fill:#fee2e2,stroke:#dc2626,stroke-width:1px;
    classDef external fill:#fefce8,stroke:#a16207,stroke-width:1px;

    class Core core;
    class Transports transport;
    class Backends backend;
    class External external;
